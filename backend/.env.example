# 学境 2.0 后端配置
APP_ENV=development
DB_BACKEND=sqlite
SQLITE_PATH=backend/data/xuejing_demo.db
LLM_OFFLINE=0
JWT_SECRET=xuejing-2-local-demo-secret
# Local HTTP uses 0; set to 1 behind HTTPS/Cloudflare.
COOKIE_SECURE=0
# lax is fine for same-site local development; use none with HTTPS when the
# Pages frontend and API are on different sites.
COOKIE_SAMESITE=lax
# Comma-separated frontend origins; set your Cloudflare Pages/Worker URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Production example (replace every placeholder):
# APP_ENV=production
# DB_BACKEND=mysql
# JWT_SECRET=<at-least-32-random-characters>
# COOKIE_SECURE=1
# COOKIE_SAMESITE=none
# CORS_ORIGINS=https://your-pages-domain.pages.dev

# 千问（文本 + 多模态共用）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DASHSCOPE_API_KEY=
QWEN_VISION_MODEL=qwen-vl-max
WAN_IMAGE_MODEL=wan2.7-image-pro
WAN_VIDEO_MODEL=wan2.7-t2v
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1

# DeepSeek（备用推理模型）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
