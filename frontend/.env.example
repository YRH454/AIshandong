# API origin, including /api/v1. Local pages automatically use the same host
# name as the page (localhost or 127.0.0.1) so session cookies keep working.
# For Cloudflare Pages, set this to the public backend URL, for example
# https://api.example.com/api/v1.
VITE_API_BASE=http://127.0.0.1:8000/api/v1
